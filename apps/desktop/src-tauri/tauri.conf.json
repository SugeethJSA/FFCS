{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FFCS Track",
  "version": "1.0.0",
  "identifier": "club.ffcs.track",
  "build": {
    "beforeDevCommand": "pnpm --filter web dev",
    "beforeBuildCommand": "pnpm --filter web build",
    "devUrl": "http://localhost:3004",
    "frontendDist": "../../web/out"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "FFCS Track",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/icon.png",
      "tooltip": "FFCS Track"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["../../extension/*"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmltYWwgc2lnbmluZyBwdWJsaWMga2V5OiAyRjJEN0Q5QzJGN0Q5QzJGN0Q5QzJGN0Q5QzJGN0Q=",
      "endpoints": ["https://ffcs.club/releases/latest.json"]
    },
    "shell": {
      "open": true
    }
  }
}
