// FFCS – Prisma schema
// Local dev: uses docker-compose Postgres (see ../docker-compose.yml) with DATABASE_URL="postgresql://ffcs:ffcs_dev_password@localhost:5432/ffcs?schema=public"
// Prod free: Neon / Supabase – set DATABASE_URL="postgresql://user:pass@host/db?sslmode=require&pgbouncer=true"
// Provider is postgresql for both (local Docker and Neon are Postgres)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MEMBER
  ADMIN
  SUPER_ADMIN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  username      String    @unique
  displayName   String
  passwordHash  String
  role          Role      @default(MEMBER)
  avatarUrl     String?
  totalPoints   Int       @default(0)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  // FFCS master fields
  registerNo    String?   @unique
  vitEmail      String?   @unique
  school        String?
  programme     String?
  mobile        String?
  isToastmaster Boolean   @default(false)
  club          String?

  pointsReceived Point[] @relation("Recipient")
  pointsAwarded  Point[] @relation("Awardee")
  refreshTokens  RefreshToken[]
  memberProfile MemberProfile?
  importBatches MemberImportBatch[] @relation("ImportBatchCreator")
  attendanceSessions AttendanceSession[]
  attendanceRecords AttendanceRecord[]
  inPersonAttendees InPersonAttendee[]

  @@index([totalPoints(sort: Desc)])
  @@index([createdAt])
}

model Category {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?
  color       String? // e.g. "#7c3aed"
  icon        String? // lucide icon name
  createdAt   DateTime @default(now())
  points      Point[]
  attendanceSessions AttendanceSession[]
}

model Point {
  id          String   @id @default(cuid())
  recipientId String
  recipient   User     @relation("Recipient", fields: [recipientId], references: [id], onDelete: Cascade)
  awardedById String
  awardedBy   User     @relation("Awardee", fields: [awardedById], references: [id], onDelete: Restrict)
  amount      Int
  reason      String
  // human-readable "where" and "how"
  where       String?  // e.g. "Tech Symposium 2026 – Main Hall"
  how         String?  // e.g. "Won 1st place in Hackathon"
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([recipientId])
  @@index([categoryId])
  @@index([createdAt])
  @@index([awardedById])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model MemberProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  programme   String
  registerNo  String   @unique
  name        String
  school      String
  email       String
  mobile      String?
  isToastmaster Boolean @default(false)
  club        String?
  importBatchId String?
  importBatch MemberImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([registerNo])
  @@index([school])
  @@index([club])
  @@index([isToastmaster])
}

model MemberImportBatch {
  id        String   @id @default(cuid())
  fileName  String
  rowCount  Int
  createdById String
  createdBy User @relation("ImportBatchCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  profiles  MemberProfile[]

  @@index([createdById])
  @@index([createdAt])
}

model AttendanceSession {
  id          String   @id @default(cuid())
  title       String
  type        String   // MEET | IN_PERSON
  meetCode    String?
  meetLink    String?
  venue       String?
  date        DateTime
  startTime   DateTime
  endTime     DateTime?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  allowedEmailDomains String? // JSON array stringified
  allowedEmails String? // JSON array
  status      String   @default("OPEN") // OPEN | CLOSED
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  points      Int?     // default points to award
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  records     AttendanceRecord[]
  inPersonEvent InPersonEvent?

  @@index([createdById])
  @@index([type])
  @@index([date])
  @@index([status])
}

model AttendanceRecord {
  id          String   @id @default(cuid())
  sessionId   String
  session     AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  rawName     String
  cleanName   String?
  registerNo  String?
  email       String?
  joinTime    DateTime?
  leaveTime   DateTime?
  attendedDuration Int? // seconds
  checkInTime DateTime?
  registrationTime DateTime?
  isPresent   Boolean  @default(false)
  source      String   // MEET_EXTENSION | MEET_CSV | QR_SCAN | MANUAL | QR_REGISTER
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([sessionId, registerNo])
  @@unique([sessionId, email])
  @@index([sessionId])
  @@index([userId])
  @@index([registerNo])
  @@index([isPresent])
}

model InPersonEvent {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  sessionId   String   @unique
  session     AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  venue       String?
  date        DateTime
  startTime   DateTime
  endTime     DateTime?
  allowedEmailDomains String?
  allowedEmails String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attendees   InPersonAttendee[]

  @@index([slug])
  @@index([sessionId])
  @@index([createdById])
}

model InPersonAttendee {
  id               String   @id @default(cuid())
  eventId          String
  event            InPersonEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkInTime      DateTime?
  registrationTime DateTime @default(now())

  @@unique([userId, eventId])
  @@index([eventId])
  @@index([userId])
}
