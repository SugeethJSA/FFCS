# ── Database ──────────────────────────────────────────────────────────
# Local WITHOUT Docker (default): SQLite file DB – zero setup, file at prisma/dev.db
DATABASE_URL="file:./dev.db"

# Local WITH Docker: Postgres via docker-compose.yml
# DATABASE_URL="postgresql://ffcs:ffcs_dev_password@localhost:5432/ffcs?schema=public"

# Prod (free cloud):
# Neon (recommended): https://neon.tech – pooled connection string
# DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/db?sslmode=require&pgbouncer=true&connection_limit=1"
# Supabase: Dashboard → Database → Connection string (pooled)
# DATABASE_URL="postgresql://postgres.xxx:password@pooler.supabase.com:5432/postgres?pgbouncer=true"
# For Neon/Supabase pooled URL, also set direct URL for migrations (optional):
# DIRECT_URL="postgresql://user:password@host:5432/db?sslmode=require"
# NOTE: for Postgres prod, also switch schema: copy prisma/schema.postgres.prisma → prisma/schema.prisma

# ── Auth ──────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-me-with-64-char-random-hex-min-32-chars-required"
JWT_ACCESS_EXPIRES="15m"
REFRESH_TOKEN_DAYS="7"

# ── Server ────────────────────────────────────────────────────────────────
PORT="4000"
NODE_ENV="development"
# Local frontend is at http://localhost:3004 (FFCS static dev)
CORS_ORIGIN="http://localhost:3004,http://localhost:3000"
# For prod: CORS_ORIGIN="https://your-frontend.github.io,https://ffcs.club"
# Rate limits
RATE_LIMIT_GENERAL="100"
RATE_LIMIT_AUTH="10"
RATE_LIMIT_AWARD="30"

# ── Seed ──────────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL="admin@ffcs.club"
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_DEMO="true"
